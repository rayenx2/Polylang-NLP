# Polylang-NLP — Environment Configuration
# Copy this file to .env and adjust values as needed.
# All models are open-source HuggingFace models downloaded locally — no paid API keys required.

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO

# ---- Sentiment Analysis ----
# Default language for sentiment analysis (en, es, fr, de, zh, multilingual)
SENTIMENT_DEFAULT_LANGUAGE=en

# ---- Question Answering / RAG ----
# Extractive QA model (HuggingFace model id, downloaded automatically on first use)
QA_MODEL=deepset/roberta-base-squad2
# Sentence-embedding model used for FAISS retrieval
RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Storage ----
MODELS_DIR=models
DATA_DIR=data

# ---- Ports (docker-compose) ----
# nlp-api (FastAPI):  http://localhost:8043
# nlp-ui  (nginx UI): http://localhost:8044
